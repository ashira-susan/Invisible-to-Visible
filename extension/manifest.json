{
  "manifest_version": 3,
  "name": "Invisible to Visible",
  "version": "0.1.0",
  "description": "Makes the invisible visible: see which sites you visit, and later what they collect. Summaries stay on your own computer.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Invisible to Visible",
    "default_popup": "popup/popup.html"
  }
}
